{
  "name": "techlyser-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/check-auth-url.mjs && prisma generate && next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:rls": "prisma db execute --file prisma/sql/enable-rls.sql --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "ai:research": "tsx --env-file=.env.local scripts/run-research-engine.ts",
    "ai:opportunities": "tsx --env-file=.env.local scripts/run-opportunity-engine.ts",
    "ai:plan": "tsx --env-file=.env.local scripts/run-content-planner.ts",
    "ai:write": "tsx --env-file=.env.local scripts/run-ai-writer.ts",
    "ai:seo": "tsx --env-file=.env.local scripts/run-seo-geo.ts",
    "ai:daily": "tsx --env-file=.env.local scripts/run-daily-autopilot.ts",
    "postinstall": "prisma generate",
    "env:check": "node scripts/check-auth-url.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.4.2",
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-color": "^3.29.0",
    "@tiptap/extension-highlight": "^3.29.0",
    "@tiptap/extension-image": "^3.29.0",
    "@tiptap/extension-link": "^3.29.0",
    "@tiptap/extension-placeholder": "^3.29.0",
    "@tiptap/extension-table": "^3.29.0",
    "@tiptap/extension-table-cell": "^3.29.0",
    "@tiptap/extension-table-header": "^3.29.0",
    "@tiptap/extension-table-row": "^3.29.0",
    "@tiptap/extension-text-style": "^3.29.0",
    "@tiptap/extension-underline": "^3.29.0",
    "@tiptap/extension-youtube": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "isomorphic-dompurify": "^3.19.0",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.7",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
    "rehype-pretty-code": "^0.14.4",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^6.19.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
