# ============================================================
# Techlyser — environment template (safe to commit)
# ============================================================
# Local development:
#   1. Copy this file to `.env.local`
#   2. Fill in real values
#   3. Keep AUTH_URL as http://localhost:3000
#
# Production (Vercel):
#   Set the SAME variable NAMES in Vercel → Settings → Environment Variables
#   Use production values there (AUTH_URL=https://techlyser.com)
#   Never put production secrets in git — push only code.
# ============================================================

# Database (Supabase / Postgres)
# Local/dev: session pooler :5432 is fine
# Vercel serverless: prefer transaction pooler :6543 + ?pgbouncer=true
# Example: ...pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL=

# Auth.js / NextAuth
# Local:  http://localhost:3000
# Prod:   https://techlyser.com   (set only on Vercel)
# Never wrap values in quotes on Vercel — they become part of the secret.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Admin seed (used by: npm run db:seed)
ADMIN_EMAIL=admin@techlyser.com
ADMIN_PASSWORD=
ADMIN_NAME=Techlyser Admin

# Email (Resend)
RESEND_API_KEY=

# Optional — Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — Search Console / Bing verification (meta tags)
# Google Search Console → Settings → Ownership verification → HTML tag
# Paste ONLY the content value (e.g. abcDEF123...), not the full meta tag
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → HTML meta tag content value
BING_SITE_VERIFICATION=

# AI Writer / Autopilot — LLM providers (pick ONE; Gemini recommended, free tier)
# Get Gemini key: https://aistudio.google.com/apikey
AI_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional free/cheap alternative: https://console.groq.com/keys
# AI_LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI (only if you add credits again)
# AI_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=dall-e-3

# Daily Autopilot — one blog DRAFT every morning at 9:00 AM IST (03:30 UTC)
# Vercel Cron hits /api/cron/daily-blog — set CRON_SECRET in Vercel env
AI_AUTOPILOT_ENABLED=true
AI_AUTOPILOT_ONCE_PER_DAY=true
# Keep false so you review in /admin/blogs then publish manually
AI_AUTOPILOT_PUBLISH=false
# Images: leave false — upload featured image yourself in admin
AI_AUTOPILOT_GENERATE_IMAGE=false
CRON_SECRET=

# Optional — AI Research Engine (Phase 2)
# Disable sources: comma-separated ids from `npm run ai:research -- --list-sources`
RESEARCH_DISABLED_SOURCES=
RESEARCH_USER_AGENT=
GITHUB_TOKEN=
PRODUCT_HUNT_TOKEN=
